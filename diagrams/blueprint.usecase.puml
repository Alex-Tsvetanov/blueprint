@startuml
' generated by Blueprint
left to right direction
title Blueprint

actor "Developer" as DEV
actor "Designer" as ARCH
actor "Build pipeline" as CI

rectangle "Blueprint" {
  usecase "Extract a model from C++ source" as UC1
  usecase "Emit a class diagram" as UC2
  usecase "Generate a relational schema" as UC3
  usecase "Generate class skeletons from a schema" as UC4
  usecase "Read a diagram back into a model" as UC5
  usecase "Report the drift between diagram and code" as UC6
  usecase "Choose the inheritance strategy" as UC7
}

DEV --> UC1
DEV --> UC2
DEV --> UC3
DEV --> UC4
ARCH --> UC2
ARCH --> UC5
ARCH --> UC6
CI --> UC6
UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC6 ..> UC1 : <<include>>
UC6 ..> UC5 : <<include>>
UC7 ..> UC3 : <<extend>>
@enduml
