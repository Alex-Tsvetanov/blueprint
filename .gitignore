# ---- LaTeX ----
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.lof
*.lot

# latexmk writes into docs/build (see docs/latexmkrc). The finished PDF is the
# deliverable and is versioned; everything else there is regenerable.
# (git does not allow a comment after a pattern on the same line)
docs/build/*
!docs/build/Main.pdf
docs/generated/

# ---- C++ / CMake ----
# Anchored with a leading slash on purpose: a bare `build/` would also swallow
# docs/build, and git cannot re-include a file inside an excluded directory,
# so the `!docs/build/Main.pdf` rule above would silently stop working.
/build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
install_manifest.txt
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.gcda
*.gcno
*.gcov
coverage/
_deps/

# ---- editors and OS ----
.vscode/
.idea/
.cache/
*.swp
.DS_Store
Thumbs.db
